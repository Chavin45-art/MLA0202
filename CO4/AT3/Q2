import numpy as np
import sklearn_crfsuite

states = ['Walking', 'Running', 'Standing']
n_states = len(states)

means = np.array([[0.15, 1.0], [2.0, 3.5], [0.02, 0.01]])
covs = np.array([[0.05, 0.05]] * n_states)
start_p = np.array([1 / 3, 1 / 3, 1 / 3])
trans_p = np.full((n_states, n_states), 0.1)
np.fill_diagonal(trans_p, 0.8)

def gaussian_prob(x, mean, cov):
    return np.exp(-0.5 * np.sum(((x - mean) ** 2) / cov)) / np.sqrt(np.prod(2 * np.pi * cov))

def viterbi(obs):
    T = len(obs)
    delta = np.zeros((T, n_states))
    psi = np.zeros((T, n_states), dtype=int)
    for s in range(n_states):
        delta[0, s] = start_p[s] * gaussian_prob(obs[0], means[s], covs[s])
    for t in range(1, T):
        for s in range(n_states):
            probs = delta[t - 1] * trans_p[:, s]
            psi[t, s] = np.argmax(probs)
            delta[t, s] = np.max(probs) * gaussian_prob(obs[t], means[s], covs[s])
    path = [int(np.argmax(delta[-1]))]
    for t in range(T - 1, 0, -1):
        path.insert(0, psi[t, path[0]])
    return path

X_test = np.array([[0.12, 1.05], [2.05, 3.55], [0.01, 0.01]])
predicted_states = viterbi(X_test)
print([states[i] for i in predicted_states])

def sensor_to_features(seq, i):
    accel, gyro = seq[i]
    feats = {'accel': accel, 'gyro': gyro, 'ratio': accel / (gyro + 1e-6)}
    if i > 0:
        feats['delta_accel'] = accel - seq[i - 1][0]
    else:
        feats['BOS'] = True
    if i == len(seq) - 1:
        feats['EOS'] = True
    return feats

def seq_to_features(seq):
    return [sensor_to_features(seq, i) for i in range(len(seq))]

X_train_crf = [
    seq_to_features([(0.1, 1.0), (0.2, 1.1), (0.15, 0.9)]),
    seq_to_features([(2.0, 3.5), (2.1, 3.6), (1.9, 3.4)]),
    seq_to_features([(0.0, 0.0), (0.05, 0.02), (0.02, 0.01)]),
]
y_train_crf = [
    ['Walking', 'Walking', 'Walking'],
    ['Running', 'Running', 'Running'],
    ['Standing', 'Standing', 'Standing'],
]

crf = sklearn_crfsuite.CRF(algorithm='lbfgs', c1=0.1, c2=0.1,
                            max_iterations=100, all_possible_transitions=True)
crf.fit(X_train_crf, y_train_crf)

X_test_crf = [seq_to_features([(0.12, 1.05), (2.05, 3.55), (0.01, 0.01)])]
print(crf.predict(X_test_crf))
