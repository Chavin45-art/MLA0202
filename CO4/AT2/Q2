import numpy as np

states = ['Healthy', 'Warning', 'Failure']
observations = ['Normal', 'HighTemp', 'HighVibration', 'HighNoise']
n_states = len(states)

start_prob = np.array([0.8, 0.15, 0.05])

trans_prob = np.array([
    [0.85, 0.12, 0.03],
    [0.10, 0.70, 0.20],
    [0.02, 0.18, 0.80]
])

emit_prob = np.array([
    [0.70, 0.15, 0.10, 0.05],
    [0.20, 0.30, 0.30, 0.20],
    [0.05, 0.15, 0.30, 0.50]
])

obs_map = {'Normal': 0, 'HighTemp': 1, 'HighVibration': 2, 'HighNoise': 3}
obs_sequence = ['Normal', 'HighTemp', 'HighVibration', 'HighVibration', 'HighNoise']
obs_indices = [obs_map[o] for o in obs_sequence]

def viterbi(obs_indices, start_prob, trans_prob, emit_prob):
    T = len(obs_indices)
    N = len(start_prob)
    delta = np.zeros((T, N))
    psi = np.zeros((T, N), dtype=int)

    delta[0] = start_prob * emit_prob[:, obs_indices[0]]

    for t in range(1, T):
        for j in range(N):
            probs = delta[t-1] * trans_prob[:, j]
            psi[t, j] = np.argmax(probs)
            delta[t, j] = np.max(probs) * emit_prob[j, obs_indices[t]]

    path = np.zeros(T, dtype=int)
    path[T-1] = np.argmax(delta[T-1])
    for t in range(T-2, -1, -1):
        path[t] = psi[t+1, path[t+1]]

    return path, np.max(delta[T-1])

hidden_path, prob = viterbi(obs_indices, start_prob, trans_prob, emit_prob)

print("Sensor Observation Sequence:", obs_sequence)
print("Predicted Hidden States:", [states[s] for s in hidden_path])
print(f"Probability of Best Path: {prob:.6f}")

final_state = states[hidden_path[-1]]
print(f"\nCurrent Predicted Machine Condition: {final_state}")
if final_state == 'Failure':
    print("Action: Immediate maintenance required.")
elif final_state == 'Warning':
    print("Action: Schedule preventive maintenance soon.")
else:
    print("Action: No maintenance needed, continue monitoring.")
