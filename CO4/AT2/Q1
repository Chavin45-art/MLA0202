from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination

model = DiscreteBayesianNetwork([
    ('PreviousFraudHistory', 'Fraudulent'),
    ('TransactionAmount', 'Fraudulent'),
    ('TransactionLocation', 'Fraudulent'),
    ('LoginDevice', 'Fraudulent')
])

cpd_amount = TabularCPD('TransactionAmount', 2, [[0.7], [0.3]],
                         state_names={'TransactionAmount': ['Low', 'High']})
cpd_location = TabularCPD('TransactionLocation', 2, [[0.8], [0.2]],
                           state_names={'TransactionLocation': ['Known', 'Unknown']})
cpd_device = TabularCPD('LoginDevice', 2, [[0.75], [0.25]],
                         state_names={'LoginDevice': ['Trusted', 'New']})
cpd_history = TabularCPD('PreviousFraudHistory', 2, [[0.9], [0.1]],
                          state_names={'PreviousFraudHistory': ['No', 'Yes']})

cpd_fraud = TabularCPD(
    'Fraudulent', 2,
    [[0.99, 0.90, 0.85, 0.60, 0.80, 0.50, 0.40, 0.10,
      0.95, 0.75, 0.70, 0.30, 0.55, 0.20, 0.15, 0.02],
     [0.01, 0.10, 0.15, 0.40, 0.20, 0.50, 0.60, 0.90,
      0.05, 0.25, 0.30, 0.70, 0.45, 0.80, 0.85, 0.98]],
    evidence=['PreviousFraudHistory', 'TransactionAmount', 'TransactionLocation', 'LoginDevice'],
    evidence_card=[2, 2, 2, 2],
    state_names={
        'Fraudulent': ['No', 'Yes'],
        'PreviousFraudHistory': ['No', 'Yes'],
        'TransactionAmount': ['Low', 'High'],
        'TransactionLocation': ['Known', 'Unknown'],
        'LoginDevice': ['Trusted', 'New']
    }
)

model.add_cpds(cpd_amount, cpd_location, cpd_device, cpd_history, cpd_fraud)
assert model.check_model()

infer = VariableElimination(model)
evidence = {'TransactionAmount': 'High', 'TransactionLocation': 'Unknown',
            'LoginDevice': 'New', 'PreviousFraudHistory': 'Yes'}

result = infer.query(variables=['Fraudulent'], evidence=evidence)
print(result)

prob_fraud = result.get_value(Fraudulent='Yes')
print(f"Probability of Fraud: {prob_fraud:.4f}")
print(f"Prediction: {'Fraudulent' if prob_fraud > 0.5 else 'Not Fraudulent'}")
print("P.N.V.CHAVIN/192525310")
