import random

# 4x4 grid world: states 0-15, goal at 15, obstacle at 5
GRID_SIZE = 4
GOAL_STATE = 15
OBSTACLES = {5, 7}

def get_states():
    return [s for s in range(GRID_SIZE * GRID_SIZE) if s not in OBSTACLES]

def get_actions():
    return ["up", "down", "left", "right"]

def next_state(s, a):
    row, col = divmod(s, GRID_SIZE)
    if a == "up":
        row = max(0, row - 1)
    elif a == "down":
        row = min(GRID_SIZE - 1, row + 1)
    elif a == "left":
        col = max(0, col - 1)
    elif a == "right":
        col = min(GRID_SIZE - 1, col + 1)
    new_s = row * GRID_SIZE + col
    return s if new_s in OBSTACLES else new_s

def get_reward(s, a, s_next):
    if s_next == GOAL_STATE:
        return 10
    if s_next in OBSTACLES:
        return -10
    return -1

def value_iteration(gamma=0.9, theta=1e-4):
    states = get_states()
    actions = get_actions()
    V = {s: 0.0 for s in states}

    while True:
        delta = 0
        for s in states:
            if s == GOAL_STATE:
                continue
            v = V[s]
            action_values = []
            for a in actions:
                s_next = next_state(s, a)
                r = get_reward(s, a, s_next)
                action_values.append(r + gamma * V[s_next])
            V[s] = max(action_values)
            delta = max(delta, abs(v - V[s]))
        if delta < theta:
            break

    policy = {}
    for s in states:
        if s == GOAL_STATE:
            policy[s] = None
            continue
        best_a, best_val = None, float("-inf")
        for a in actions:
            s_next = next_state(s, a)
            r = get_reward(s, a, s_next)
            val = r + gamma * V[s_next]
            if val > best_val:
                best_val, best_a = val, a
        policy[s] = best_a

    print("Optimal Values:")
    for s in states:
        print(f"  State {s}: {V[s]:.2f}")
    print("Optimal Policy:")
    for s in states:
        print(f"  State {s}: {policy[s]}")
    return V, policy

value_iteration()
