import random

NUM_STATES = 10
TERMINAL_STATE = 9

def choose_action(state):
    return random.choice(["advance", "retreat", "hold"])

def take_action(state, action):
    if action == "advance":
        next_s = min(TERMINAL_STATE, state + 1)
    elif action == "retreat":
        next_s = max(0, state - 1)
    else:
        next_s = state

    reward = 1.0 if next_s == TERMINAL_STATE else -0.1
    done = (next_s == TERMINAL_STATE)
    return reward, next_s, done

def td_learning(alpha=0.1, gamma=0.9, num_episodes=1000):
    V = {s: 0.0 for s in range(NUM_STATES)}

    for episode in range(num_episodes):
        s = 0
        done = False
        while not done:
            a = choose_action(s)
            reward, s_next, done = take_action(s, a)
            V[s] += alpha * (reward + gamma * V[s_next] - V[s])
            s = s_next

    print("Learned state values:")
    for s in range(NUM_STATES):
        print(f"  State {s}: {V[s]:.3f}")
    return V

td_learning()
