
import numpy as np
from sklearn.datasets import load_iris
from sklearn.mixture import GaussianMixture
from sklearn.metrics import accuracy_score, confusion_matrix
from scipy.stats import mode

iris = load_iris()
X, y = iris.data, iris.target

gmm = GaussianMixture(n_components=3, random_state=42, max_iter=200)
gmm.fit(X)
y_pred = gmm.predict(X)

# Map each cluster to the most frequent true label in that cluster
labels_mapped = np.zeros_like(y_pred)
for cluster in range(3):
    mask = (y_pred == cluster)
    labels_mapped[mask] = mode(y[mask], keepdims=True).mode[0]

print("Converged:", gmm.converged_)
print("Number of EM iterations run:", gmm.n_iter_)
print("\nLearned means (per component):\n", gmm.means_)
print("\nConfusion Matrix:\n", confusion_matrix(y, labels_mapped))
print("\nAccuracy:", accuracy_score(y, labels_mapped))

