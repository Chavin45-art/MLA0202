"""
Task 3: Dimensionality Reduction using PCA, Factor Analysis, and ICA
Dataset: Wine dataset from Scikit-learn
Compares the three techniques and their role in tackling the
Curse of Dimensionality.
"""
import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import load_wine
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA, FactorAnalysis, FastICA

# 1. Load and standardize data
wine = load_wine()
X, y = wine.data, wine.target
X_scaled = StandardScaler().fit_transform(X)
print(f"Original dimensionality: {X.shape[1]} features, {X.shape[0]} samples")

# 2. Apply PCA
pca = PCA(n_components=2, random_state=42)
X_pca = pca.fit_transform(X_scaled)
print(f"PCA explained variance ratio: {pca.explained_variance_ratio_.round(3)} "
      f"(total {pca.explained_variance_ratio_.sum():.3f})")

# 3. Apply Factor Analysis
fa = FactorAnalysis(n_components=2, random_state=42)
X_fa = fa.fit_transform(X_scaled)

# 4. Apply ICA
ica = FastICA(n_components=2, random_state=42, max_iter=1000)
X_ica = ica.fit_transform(X_scaled)

# 5. Visualize all three side by side
fig, axes = plt.subplots(1, 3, figsize=(16, 5))
for ax, X_proj, title in zip(
    axes, [X_pca, X_fa, X_ica], ["PCA", "Factor Analysis", "ICA"]
):
    sc = ax.scatter(X_proj[:, 0], X_proj[:, 1], c=y, cmap="viridis", s=40, edgecolor="k")
    ax.set_title(f"{title} (Wine dataset)")
    ax.set_xlabel("Component 1"); ax.set_ylabel("Component 2")
plt.colorbar(sc, ax=axes, label="Wine class")
plt.savefig("pca_fa_ica_wine.png", dpi=120)
print("\nSaved visualization: pca_fa_ica_wine.png")

# 6. Component loadings comparison (PCA vs FA) for interpretability
print("\nTop PCA loadings (component 1):")
loadings = pd = np.abs(pca.components_[0])
top_idx = np.argsort(loadings)[::-1][:5]
for i in top_idx:
    print(f"  {wine.feature_names[i]}: {pca.components_[0][i]:.3f}")

# 7. Discussion (printed): how each addresses the Curse of Dimensionality
print("""
--- Curse of Dimensionality: how each technique helps ---
PCA: Projects data onto orthogonal axes of maximum variance, removing
     redundant/correlated features and shrinking the feature space while
     preserving most information -> mitigates sparsity in high-D space.
Factor Analysis: Models observed features as linear combinations of a
     smaller set of latent factors plus noise, useful when features share
     underlying causes -> reduces dimensions while explaining correlation.
ICA: Finds statistically independent components (not just uncorrelated),
     useful for separating mixed signals/sources -> reduces dimensionality
     while preserving distinct, non-Gaussian underlying structure.
""")
