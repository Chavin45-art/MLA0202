"""
Task 2: Clustering using EM Algorithm and Gaussian Mixture Model
Dataset: Digits dataset from Scikit-learn
Compares Gaussian Mixture Model (EM) with K-Means, visualized via PCA.
"""
import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import load_digits
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans
from sklearn.mixture import GaussianMixture
from sklearn.metrics import (
    silhouette_score, adjusted_rand_score, normalized_mutual_info_score
)

# 1. Load and preprocess data
digits = load_digits()
X, y_true = digits.data, digits.target
X_scaled = StandardScaler().fit_transform(X)
n_clusters = len(np.unique(y_true))  # 10 digit classes

# 2. Reduce dimensions for faster/cleaner clustering (keep 95% variance)
pca_full = PCA(n_components=0.95, random_state=42)
X_reduced = pca_full.fit_transform(X_scaled)
print(f"Reduced dimensions: {X_reduced.shape[1]} components")

# 3. K-Means clustering
kmeans = KMeans(n_clusters=n_clusters, random_state=42, n_init=10)
km_labels = kmeans.fit_predict(X_reduced)

# 4. Gaussian Mixture Model (EM Algorithm)
gmm = GaussianMixture(n_components=n_clusters, covariance_type="full", random_state=42)
gmm_labels = gmm.fit_predict(X_reduced)

# 5. Evaluate both methods
def report(name, labels):
    sil = silhouette_score(X_reduced, labels)
    ari = adjusted_rand_score(y_true, labels)
    nmi = normalized_mutual_info_score(y_true, labels)
    print(f"{name:10s} | Silhouette: {sil:.3f} | ARI: {ari:.3f} | NMI: {nmi:.3f}")
    return sil, ari, nmi

print("\n--- Clustering Evaluation ---")
report("K-Means", km_labels)
report("GMM (EM)", gmm_labels)

# 6. Visualize clusters in 2D via PCA
pca_2d = PCA(n_components=2, random_state=42)
X_2d = pca_2d.fit_transform(X_scaled)

fig, axes = plt.subplots(1, 2, figsize=(13, 5))
for ax, labels, title in zip(axes, [km_labels, gmm_labels], ["K-Means", "GMM (EM Algorithm)"]):
    sc = ax.scatter(X_2d[:, 0], X_2d[:, 1], c=labels, cmap="tab10", s=15)
    ax.set_title(f"{title} Clusters (PCA-projected)")
    ax.set_xlabel("PC1"); ax.set_ylabel("PC2")
plt.colorbar(sc, ax=axes, label="Cluster")
plt.savefig("gmm_vs_kmeans_digits.png", dpi=120)
print("\nSaved visualization: gmm_vs_kmeans_digits.png")
